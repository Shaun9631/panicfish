# ==========================================
# Panic Fish Bot - Configuration File
# ==========================================

# Your Lichess API Token (starts with lip_...)
# Create one at: https://lichess.org/account/oauth/token
# Required Scopes: bot:play, challenge:read, challenge:write, chat:write
LICHESS_API_TOKEN=your_lichess_token_here

# Path to Stockfish executable (leave empty to use default ./engine/stockfish.exe)
STOCKFISH_PATH=

# Starting Elo rating (Stockfish starts at 3600 GM level)
STARTING_ELO=3600

# Elo penalty per check against the bot's king
ELO_DROP_PER_CHECK=300

# Minimum floor rating (0 Elo = complete blunder / potato mode)
MIN_ELO=0

# Announce checks and Elo drops in the Lichess in-game chat
SEND_CHAT_ALERTS=true

# Allowed game variants (comma separated: standard, rapid, blitz, etc.)
ACCEPT_VARIANTS=standard

# Max simultaneous active games
MAX_CONCURRENT_GAMES=5
